table fact_sales
	lineageTag: afe67836-18a5-4288-8d08-04925694ee30

	measure 'Total Revenue' = SUM(fact_sales[line_total])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: eae4eb19-5ed6-4aa9-b826-6012b4b209f1

	measure 'Total Orders' = DISTINCTCOUNT(fact_sales[order_id])
		formatString: 0
		lineageTag: 7b3019fb-1316-4895-aa42-5de88943d7be

	measure 'Total Units Sold' = SUM(fact_sales[quantity])
		formatString: 0
		lineageTag: 37ff61f4-587f-4f86-978a-e41444cea18d

	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders], 0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 170228ef-7a0c-46af-beba-008dc6855ea4

	measure 'Revenue per Customer' = DIVIDE([Total Revenue], DISTINCTCOUNT(dim_customer[customer_id]), 0)
		lineageTag: 243df456-8088-43f7-9cb4-3ec755f4e1e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

